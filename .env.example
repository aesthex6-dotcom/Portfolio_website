# ─────────────────────────────────────────────────────────────
#  OPTIONAL environment variables (copy to `.env` to enable).
#  None are required — the site works fully offline without them.
# ─────────────────────────────────────────────────────────────

# GitHub — raises the public API rate limit (60 → 5000 req/hr) for the
# live stats band. Create a token at https://github.com/settings/tokens
# with the `public_repo` / read scope. No token = anonymous access.
VITE_GITHUB_TOKEN=

# Connect the AI assistant to a real LLM. When both are set, the chat
# calls your endpoint instead of the built-in local engine:
#   POST {endpoint}   { "message": "..." }
#   → 200 { "text": "..." }
# (See README → "Connecting a real LLM" for the full contract.)
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
